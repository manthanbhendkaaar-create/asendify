{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/login",
      "destination": "/app/index.html"
    },
    {
      "source": "/login/",
      "destination": "/app/index.html"
    },
    {
      "source": "/paid",
      "destination": "/app/index.html"
    },
    {
      "source": "/paid/",
      "destination": "/app/index.html"
    },
    {
      "source": "/blog",
      "destination": "https://playbook.asendify.co/api/blog?svc=notes"
    },
    {
      "source": "/blog/",
      "destination": "https://playbook.asendify.co/api/blog?svc=notes"
    },
    {
      "source": "/blog/:slug",
      "destination": "https://playbook.asendify.co/api/blog?svc=notes&slug=:slug"
    },
    {
      "source": "/blog/:slug/",
      "destination": "https://playbook.asendify.co/api/blog?svc=notes&slug=:slug"
    },
    {
      "source": "/blog-sitemap.xml",
      "destination": "https://playbook.asendify.co/api/blog?svc=notes&sitemap=1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/(app|login|paid|s)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
